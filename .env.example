# Kimi (Moonshot AI) — get a token at https://platform.moonshot.ai/
KIMI_API_TOKEN=sk-your-kimi-token
# Optional overrides (these are the defaults):
KIMI_BASE_URL=https://api.moonshot.ai/anthropic
KIMI_MODEL=kimi-k2.6
# Extended-thinking budget in tokens; 0 disables thinking (recommended).
KIMI_THINKING_BUDGET=0

# Optimizer settings (optional, these are defaults)
OPTIMIZATION_ROUNDS=3
TARGET_SCORE=95
